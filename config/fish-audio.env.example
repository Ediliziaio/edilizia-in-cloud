# Copia in .env.fish.local, già escluso da Git. Non usare variabili VITE_ per segreti.
# La chiave si inserisce solo sul computer, mai in chat o nel browser.
FISH_API_KEY=
# Genera un valore casuale dedicato lungo almeno 32 caratteri. Non usare l'API key.
FISH_WEBHOOK_SECRET=
# Base HTTPS pubblica del backend per il collaudo telefonico, inclusa /functions/v1.
# Non serve per le simulazioni locali. Non inserire chiavi in questo URL.
FISH_BACKEND_URL=
FISH_VOICE_ID=
FISH_TTS_MODEL=s2.1-pro-free
# Porta locale facoltativa, 1024-65535.
FISH_LOCAL_PORT=8797
