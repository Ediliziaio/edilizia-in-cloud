{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    // ES2022 e non ES2020: il codice usa gia' String.replaceAll (ES2021) e
    // Array.at (ES2022) e in produzione funzionano — era la configurazione a
    // essere indietro, non il codice.
    "lib": [
      "ES2022",
      "ES2023.Intl",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2020",
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.app.tsbuildinfo",
    "types": [
      "vitest/globals"
    ],
    "useDefineForClassFields": true
  },
  "include": [
    "src"
  ],
  // I dizionari delle lingue (567.000 righe di frasi) si importano con «?dizionario» e hanno il tipo in
  // src/lib/campo/lingua/dizionari.d.ts: analizzarli uno per uno portava il typecheck oltre i 12 GB del CI.
  "exclude": [
    "src/lib/campo/lingua/dizionari/**"
  ]
}
