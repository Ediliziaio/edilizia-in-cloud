# manifest.json: senza una regola esplicita vale il default di Cloudflare Pages
# (max-age=0, must-revalidate) → cf-cache-status DYNAMIC → la Pages Function
# viene invocata a OGNI richiesta. E il manifest e' linkato da 194 pagine su
# 241: una richiesta per ogni caricamento, sia utenti sia crawler. Con la quota
# Workers Free a 100k invocazioni/giorno (17/08/2026: 84.754 consumate durante
# un burst di crawler USA) e' una delle voci piu' pesanti e piu' inutili.
# Il file cambia solo ai deploy, che purgano la cache: 1 giorno di edge TTL
# non ha controindicazioni.
# ATTENZIONE (verificato live 17/08/2026): questo header da solo NON basta.
# Le risposte che passano dalla Pages Function restano cf-cache-status DYNAMIC
# qualunque Cache-Control abbiano — vale anche per i 301 canonici in
# _middleware.js. L'header e' il PREREQUISITO: diventa efficace solo quando una
# Cache Rule di zona rende il path "Eligible for cache" con Edge TTL "use
# cache-control header if present". Senza quella regola sul pannello, manifest
# e og continuano a invocare la Function.
/manifest.json
  Cache-Control: public, max-age=3600, s-maxage=86400

# Immagini Open Graph: richieste dai crawler social a ogni condivisione,
# cambiano solo ai deploy. Stesso ragionamento del manifest.
/og/*
  Cache-Control: public, max-age=604800

# Cache static assets aggressively
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets-v2/*
  Cache-Control: public, max-age=31536000, immutable

# Nuova namespace bundle dopo cache poisoning Cloudflare. Non usare immutable:
# se durante un deploy la SPA fallback risponde HTML a un URL JS/CSS, il
# browser deve poter revalidare e recuperare senza restare bloccato in bianco.
/assets-v3/*
  Cache-Control: public, max-age=0, must-revalidate

/assets-v4/*
  Cache-Control: public, max-age=0, must-revalidate

/assets-cb1/*
  Cache-Control: public, max-age=0, must-revalidate

/assets-cb2/*
  Cache-Control: public, max-age=0, must-revalidate

/assets-cb3/*
  Cache-Control: public, max-age=0, must-revalidate

# Never cache index.html — ensure fresh deploys load immediately
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

