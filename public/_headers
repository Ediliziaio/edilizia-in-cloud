# (Google lo processa comunque per il crawling — fix GSC "Scansionata ma
# attualmente non indicizzata" su /sitemap.xml).
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex

