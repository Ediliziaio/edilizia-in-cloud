# Content-Type for sitemap and robots
# noindex: il file sitemap non deve apparire come risultato di ricerca
# (Google lo processa comunque per il crawling — fix GSC "Scansionata ma
# attualmente non indicizzata" su /sitemap.xml).
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex, follow

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex, follow

/62ac6a799ade356135bf527565c13e17.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# v8.6.123 — HOMEPAGE: HTTP/2 Early Hints (103) + Link preload header
# Cloudflare può fare Server Push via Link header al primo byte HTML,
# permettendo al browser di iniziare il download asset critici PRIMA che
# arrivi il body HTML. Riduce critical render path di ~50-100ms.
/
  Link: </fonts/inter-latin-400-normal.woff2>; rel=preload; as=font; type=font/woff2; crossorigin
  Link: </fonts/inter-latin-700-normal.woff2>; rel=preload; as=font; type=font/woff2; crossorigin
# Preload hero RIMOSSO (perf 11/06): l'<img> sta nell'HTML prerenderato con
# fetchpriority=high (discovery immediata) e il nuovo <picture> limita i
# telefoni alla 768w — il Link header con imagesizes=100vw avrebbe
# precaricato la 1440w in parallelo = doppio download su mobile.

# Security headers for all pages
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://cdn.jsdelivr.net https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https: http:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https://api.open-meteo.com https://graph.facebook.com https://*.facebook.com; frame-src 'self' blob: https://www.google.com https://www.youtube.com https://www.youtube-nocookie.com https://www.facebook.com https://web.facebook.com https://m.facebook.com https://business.facebook.com; object-src 'none'; base-uri 'self'

# Inter font self-hosted — immutable 1y (woff2 dal version 5.1.0 di @fontsource/inter)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: font/woff2
  Access-Control-Allow-Origin: *

# Hero images self-hosted — immutable 1y (mai cambieranno, hash-based naming via build)
/hero/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/webp

# Icons + manifest
/icons/*
  Cache-Control: public, max-age=2592000

# Cache static assets aggressively
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets-v2/*
  Cache-Control: public, max-age=31536000, immutable

# Nuova namespace bundle dopo cache poisoning Cloudflare. Non usare immutable:
# se durante un deploy la SPA fallback risponde HTML a un URL JS/CSS, il
# browser deve poter revalidare e recuperare senza restare bloccato in bianco.
/assets-v3/*
  Cache-Control: public, max-age=0, must-revalidate

/assets-v4/*
  Cache-Control: public, max-age=0, must-revalidate

/assets-cb1/*
  Cache-Control: public, max-age=0, must-revalidate

/assets-cb2/*
  Cache-Control: public, max-age=0, must-revalidate

# Never cache index.html — ensure fresh deploys load immediately
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Never cache service worker files — they must always be fresh
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
/registerSW.js
  Cache-Control: no-cache, no-store, must-revalidate
/workbox-*.js
  Cache-Control: no-cache, no-store, must-revalidate

/sw-fleet-track.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /
  Content-Type: application/javascript

