  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/immobiliare.tsbuildinfo",
    "types": ["vite/client"]
  },
  "include": [
    "src/vite-env.d.ts",
    "src/types/pdfmake.d.ts",
