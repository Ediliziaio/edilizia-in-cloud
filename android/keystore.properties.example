# Copia questo file in android/keystore.properties e NON committare il file reale.
# In alternativa puoi usare le stesse chiavi come variabili ambiente.
#
# Percorso relativo alla cartella android/ oppure assoluto.
ANDROID_KEYSTORE_FILE=ediliziaincloud-upload-key.jks
ANDROID_KEYSTORE_PASSWORD=change-me
ANDROID_KEY_ALIAS=ediliziaincloud
ANDROID_KEY_PASSWORD=change-me
