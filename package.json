{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 vite build && npm run playwright:ensure && NODE_OPTIONS=--max-old-space-size=8192 node scripts/prerender.mjs",
    "build:fast": "NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=12288 tsc --noEmit -p tsconfig.app.json",
    "typecheck:ci": "node scripts/typecheck-ratchet.mjs",
    "typecheck:baseline": "node scripts/typecheck-ratchet.mjs --update",
    "seo:audit": "node scripts/seo-audit.mjs",
    "prerender": "node scripts/prerender.mjs",
    "prerender:verify": "node scripts/prerender-verify.mjs",
    "playwright:ensure": "npx --yes playwright install chromium-headless-shell || npx --yes playwright install chromium",
    "build:seo": "NODE_OPTIONS=--max-old-space-size=8192 vite build && npm run playwright:ensure && NODE_OPTIONS=--max-old-space-size=8192 node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:critical": "vitest run src/test/logic/fatturazione.test.ts src/test/logic/preventivi.test.ts src/test/logic/banking.test.ts src/test/logic/preventiviUnificati.test.ts src/test/logic/funzioniChiamateSenzaJwt.test.ts src/test/logic/funzioniSenzaJwtConControllo.test.ts src/test/ui/cambioRuoloUtente.test.tsx src/test/ui/permessiDiconoLaVerita.test.tsx src/test/ui/ruoliAggiuntivi.test.tsx src/test/ui/impostazioniDelPiano.test.tsx src/test/logic/telefoniaSoloAdminRestoSeguePermesso.test.ts src/test/security/whatsappNumeriSegreti.test.ts src/test/logic/funzioniServerPermessoAzienda.test.ts src/test/logic/funzioniInterneSoloAlServizio.test.ts src/test/logic/creditiSiRicaricanoSoloPagando.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:ui": "playwright test --ui",
    "mobile:build": "VITE_APP_MODE=mobile vite build",
    "mobile:sync": "npx cap sync",
    "mobile:doctor": "npx cap doctor",
    "mobile:android:debug": "npm run mobile:build && npm run mobile:sync && scripts/mobile/android-gradle.sh :app:assembleDebug",
    "mobile:android:release": "npm run mobile:build && npm run mobile:sync && scripts/mobile/android-gradle.sh :app:bundleRelease",
    "mobile:android": "npx cap open android",
    "mobile:ios": "npx cap open ios",
    "mobile:run:android": "npx cap run android",
    "mobile:run:ios": "npx cap run ios",
    "mobile:dev": "VITE_APP_MODE=mobile vite build --watch & npx cap sync --inline"
  },
