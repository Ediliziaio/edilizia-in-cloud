 const analyzeRepeatedExtglob = (body, options) => {
+  // EIC security hardening: a wildcard inside a repeated single branch can
+  // generate nested unbounded quantifiers (CVE-2026-112366). Treat these
+  // patterns literally, as the parser already does for risky alternatives.
+  const single = splitTopLevel(body).map(branch => branch.trim());
+  if (single.length === 1 && !normalizeSimpleBranch(single[0]) &&
+      !getStarExtglobSequenceOutput(single[0])) {
+    return { risky: true };
+  }
   if (options.maxExtglobRecursion === false) {
     return { risky: false };
   }
