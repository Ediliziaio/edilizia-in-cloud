HOST=127.0.0.1
PORT=3098
# Use a random secret of at least 32 bytes, identical to the Edge Function secret.
SMTS_GATEWAY_SECRET=
SMTS_DATA_DIR=./data
# Set true only AFTER SdICoop accreditation and SMTS activation are completed.
SMTS_ACCREDITED=false
# Only VATs that have enabled THIS provider in Fatture e Corrispettivi.
SMTS_PROVIDER_ENABLED_VATS=
SMTS_CLIENT_CERT=./certs/client.pem
SMTS_CLIENT_KEY=./certs/client-key.pem
SMTS_CA=./certs/ca.pem
SMTS_KEY_PASSPHRASE=
# Optional SdICoop transmission callbacks; public endpoint uses mutual TLS here.
SMTS_SERVER_CERT=
SMTS_SERVER_KEY=
SMTS_SERVER_KEY_PASSPHRASE=
SMTS_SDI_CLIENT_CERTS=
SMTS_CALLBACK_HOST=127.0.0.1
SMTS_CALLBACK_PORT=3100
