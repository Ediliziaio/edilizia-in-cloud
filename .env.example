# ============================================================
# Edilizia in Cloud — Variabili d'Ambiente
# Copia questo file in .env e inserisci i valori reali.
# NON committare mai il file .env su Git.
# ============================================================

# ============================================================
# FRONTEND — Supabase
# ============================================================
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGci...
VITE_SUPABASE_PROJECT_ID=your-project-id

# ============================================================
# PUBLIC CHAT WIDGET — token visibile pubblicamente (lead capture sito)
# ============================================================
# UUID widget configurato in public_chatbot_settings.public_widget_token.
# Per il sito hosting di EiC, usa il token della Demo Azienda S.r.l.:
#   859db08e-494d-4b15-ba85-7da57849df87
# Lascia vuoto per disabilitare il widget sul sito.
VITE_PUBLIC_CHAT_TOKEN=

# ============================================================
# VELOCITY / OSSERVABILITÀ (opzionali)
# ============================================================
# Sentry DSN (opt-in). Se vuoto, Sentry non viene inizializzato.
VITE_SENTRY_DSN=
# Release/commit sha per taggare gli eventi (opzionale)
VITE_APP_VERSION=
VITE_COMMIT_SHA=

# ============================================================
# EDGE FUNCTIONS — Supabase (server-side, non esporre al frontend)
# ============================================================
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
SUPABASE_ANON_KEY=eyJhbGci...

# ============================================================
# SICUREZZA — Cron Secret (protezione funzioni senza auth utente)
# Genera con: openssl rand -hex 32
# Usato da: compute-health-scores, check-scadenze-alerts, process-internal-automation
# ============================================================
INTERNAL_CRON_SECRET=

# ============================================================
# STRIPE (pagamenti e abbonamenti)
# ============================================================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# ============================================================
# EMAIL — Dual-Provider (FASE 11)
# ============================================================
# Architettura:
#   - Resend  = default transactional (notifiche.ediliziaincloud.it)
#   - Elastic Email = marketing (mail.ediliziaincloud.it)
#   - SendGrid = legacy transactional (fallback + custom domain whitelabel)
#   - Brevo / Mailgun = supportati via custom domain per backward compat
#
# Ogni provider ha (a) API key per invio, (b) webhook secret per ricezione
# eventi (delivered/bounced/complained/unsubscribed).
# ============================================================

# ── Resend (default transactional) ────────────────────────────
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY=re_...
# Region: eu-west-1 consigliato per GDPR (FR data center)
RESEND_REGION=eu-west-1

# ── Elastic Email (marketing) ─────────────────────────────────
# Dashboard: https://app.elasticemail.com/api/settings/apiconfig
ELASTIC_EMAIL_API_KEY=
# Account email per whitelabel domain verification
ELASTIC_EMAIL_ACCOUNT_EMAIL=

# ── SendGrid (legacy transactional + whitelabel custom domain) ─
# Dashboard: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG....
# Parent subuser account per multi-tenant whitelabel (opzionale)
SENDGRID_SUBUSER=

# ── Brevo (alternativa marketing) ─────────────────────────────
# Dashboard: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# ── Mailgun (alternativa transactional) ───────────────────────
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ── SMTP generico (ultima fallback) ───────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Webhook provider events (FASE 10) ─────────────────────────
# Token per validare richieste in arrivo su /email-provider-webhook.
# Configurare lo stesso valore sia qui che sulla dashboard di ogni provider.
# Genera con: openssl rand -hex 32
WEBHOOK_SECRET=

# ============================================================
# META / FACEBOOK LEAD ADS
# ============================================================
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# ============================================================
# WHATSAPP (se integrato)
# ============================================================
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# ============================================================
# GOOGLE CALENDAR
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# ELEVENLABS VOICE (se integrato)
# ============================================================
ELEVENLABS_API_KEY=

# ============================================================
# WEB PUSH NOTIFICATIONS (VAPID) — MP5 Documenti Operai
# Genera con: bunx web-push generate-vapid-keys
# La chiave privata va SOLO in Supabase Secrets (mai qui).
# ============================================================
VITE_VAPID_PUBLIC_KEY=

# ============================================================
# BANKING / GOCARDLESS
# (salvare in platform_settings, non qui)
# ============================================================
# GOCARDLESS_SECRET_ID=
# GOCARDLESS_SECRET_KEY=

# Mappa operativa — SFONDO (frontend). Opzionale: se non imposti nulla, lo sfondo usa
# OpenFreeMap (vettoriale, senza chiave, uso commerciale consentito) come predefinito.
# STYLE_URL = stile vettoriale MapLibre (es. https://tiles.openfreemap.org/styles/liberty);
# TILE_URL = raster XYZ/MapTiler con chiave limitata ai domini dell'app. STYLE prevale su TILE.
VITE_MAPPA_OPERATIVA_STYLE_URL=
VITE_MAPPA_OPERATIVA_TILE_URL=
# Mostrare Furgone solo con profilo dedicato anche lato Edge Function.
VITE_MAPPA_OPERATIVA_FURGONE=false

# Mappa operativa — SERVIZI (Edge Function mappa-operativa). Il codice rifiuta di proposito
# OSRM/Nominatim PUBBLICI: servono endpoint dedicati (self-hosted o a pagamento).
# - OSRM_URL: routing stradale per «Percorso», distanze, tempi e «Chi è più vicino su strada».
#   Senza, quelle funzioni restano inerti e «Chi è più vicino?» usa solo la linea d'aria.
# - GEOCODING_URL: ricerca indirizzo manuale per posizionare un pin. Se vuoto, la ricerca
#   indirizzo ripiega sul geocoder HERE condiviso (HERE_API_KEY), quindi funziona lo stesso.
MAPPA_OPERATIVA_OSRM_URL=
MAPPA_OPERATIVA_OSRM_FURGONE_URL=
MAPPA_OPERATIVA_OSRM_TOKEN=
MAPPA_OPERATIVA_GEOCODING_URL=
MAPPA_OPERATIVA_GEOCODING_TOKEN=
MAPPA_OPERATIVA_DATI_VERSIONE=1
