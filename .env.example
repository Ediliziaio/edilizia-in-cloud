# ============================================================
# Edilizia in Cloud — Variabili d'Ambiente
# Copia questo file in .env e inserisci i valori reali.
# NON committare mai il file .env su Git.
# ============================================================

# ============================================================
# FRONTEND — Supabase
# ============================================================
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGci...
VITE_SUPABASE_PROJECT_ID=your-project-id

# ============================================================
# EDGE FUNCTIONS — Supabase (server-side, non esporre al frontend)
# ============================================================
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
SUPABASE_ANON_KEY=eyJhbGci...

# ============================================================
# STRIPE (pagamenti e abbonamenti)
# ============================================================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# ============================================================
# EMAIL (scegli uno dei provider)
# ============================================================
# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# SendGrid
SENDGRID_API_KEY=
# SMTP generico
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ============================================================
# META / FACEBOOK LEAD ADS
# ============================================================
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# ============================================================
# WHATSAPP (se integrato)
# ============================================================
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# ============================================================
# GOOGLE CALENDAR
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# ELEVENLABS VOICE (se integrato)
# ============================================================
ELEVENLABS_API_KEY=

# ============================================================
# BANKING / GOCARDLESS
# (salvare in platform_settings, non qui)
# ============================================================
# GOCARDLESS_SECRET_ID=
# GOCARDLESS_SECRET_KEY=
